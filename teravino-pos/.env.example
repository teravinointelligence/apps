# Copia este archivo como .env.local y rellena los valores.
# Las credenciales reales viven solo en .env.local (gitignored) y en Vercel.

# Supabase del CRM TeraVino (proyecto teravino-crm). La llave pública
# (publishable / anon) es la misma que usa el CRM en el navegador.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_KEY=sb_publishable_your-publishable-key
